<?xml version="1.0" encoding="UTF-8"?>
<Defs>

  <!-- ============================================================
       可脫離模塊示範:燒蝕裝甲板 (Ablative Plate)
       耐久用盡 → 自動拋離機體 → 回復一半損耗並重算耐久 → 落地可回收
       ============================================================ -->

  <!-- 物品形態 -->
  <ThingDef ParentName="ModuleItemAttachment">
    <defName>MF_Module_AblativePlate</defName>
    <label>ablative plate module</label>
    <description>A sacrificial armor plate for exosuits. It soaks up incoming damage in place of other modules; once its structural integrity is exhausted, the plate automatically jettisons from the suit. The ejected plate retains half of its lost durability and can be repaired and reinstalled.</description>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <MarketValue>450</MarketValue>
      <Mass>12</Mass>
      <WorkToMake>9000</WorkToMake>
    </statBases>
    <costList>
      <Steel>80</Steel>
      <Plasteel>10</Plasteel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="Exosuit.CompProperties_EjectableModule">
        <!-- 抽象組件:必須指定繼承 CompSuitModule_Ejectable 的具體類別 -->
        <compClass>Exosuit.CompSuitModule_AblativePlate</compClass>
        <EquipedThingDef>MF_Apparel_AblativePlate</EquipedThingDef>
        <ItemDef>MF_Module_AblativePlate</ItemDef>
        <occupiedSlots>
          <li>Attachment</li>
        </occupiedSlots>
        <repairEfficiency>0.02</repairEfficiency>
        <!-- 脫離時回復的耐久損耗比例,預設 0.5 (一半) -->
        <recoverFraction>0.5</recoverFraction>
        <showEjectMessage>true</showEjectMessage>
      </li>
    </comps>
    <recipeMaker>
      <researchPrerequisite>WG_HeavyExoskeleton</researchPrerequisite>
      <recipeUsers>
        <li>FabricationBench</li>
      </recipeUsers>
    </recipeMaker>
  </ThingDef>

  <!-- 裝備形態 -->
  <ThingDef ParentName="ModuleApparelAttachment">
    <defName>MF_Apparel_AblativePlate</defName>
    <label>ablative plate module</label>
    <description>A sacrificial armor plate mounted on the exosuit. Jettisons automatically when depleted.</description>
    <graphicData>
      <texPath>Things/Item/Module_A</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <ArmorRating_Sharp>0.45</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.35</ArmorRating_Blunt>
      <ArmorRating_Heat>0.4</ArmorRating_Heat>
      <Mass>12</Mass>
      <EquipDelay>2</EquipDelay>
    </statBases>
    <comps>
      <li Class="Exosuit.CompProperties_EjectableModule">
        <compClass>Exosuit.CompSuitModule_AblativePlate</compClass>
        <EquipedThingDef>MF_Apparel_AblativePlate</EquipedThingDef>
        <ItemDef>MF_Module_AblativePlate</ItemDef>
        <occupiedSlots>
          <li>Attachment</li>
        </occupiedSlots>
        <repairEfficiency>0.02</repairEfficiency>
        <recoverFraction>0.5</recoverFraction>
        <showEjectMessage>true</showEjectMessage>
      </li>
    </comps>
  </ThingDef>

</Defs>
